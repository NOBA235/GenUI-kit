{
  "name": "@genui-studio/spatial-ops",
  "version": "1.0.0",
  "private": true,
  "description": "Domain App 2: Aegis Spatial Ops & Incident Command Center — Autonomous SRE & 3D Cluster Topology Command Center combining @json-render/react-three-fiber 3D scenes with @json-render/shadcn 2D playbooks over a shared bidirectional StateStore.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:demo": "node scripts/dev.mjs --demo",
    "demo:emit-otlp": "node examples/emit-otlp-sample.mjs",
    "collector": "tsc -p tsconfig.server.json && node dist-server/server/cli.js",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "preview": "vite preview --port 4174",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@genui-studio/core": "workspace:*",
    "@json-render/core": "^0.22.0",
    "@json-render/react": "^0.22.0",
    "@json-render/react-three-fiber": "^0.22.0",
    "@json-render/shadcn": "^0.22.0",
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "fast-check": "^4.10.2",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.173.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/three": "^0.173.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.0"
  }
}
