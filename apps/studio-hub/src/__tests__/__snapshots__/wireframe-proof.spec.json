        "layoutDensity": "spacious",
        "tagline": "14 Verified Catalog Components"
      },
      "children": [
        "wf-blk-hero",
        "wf-blk-metrics",
        "wf-blk-features",
        "wf-aa-note",
        "wf-zz-note",
        "wf-blk-rogue"
      ]
    },
    "wf-blk-hero": {
      "type": "HeroSection",
      "props": {
        "eyebrow": "3D / WebGL · @genui-studio/core",
