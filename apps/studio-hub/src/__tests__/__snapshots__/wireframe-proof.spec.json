{
  "root": "wf-frame-page",
  "elements": {
    "wf-frame-page": {
      "type": "SiteShell",
      "props": {
        "badge": "WIREFRAME LIVE",
        "brandName": "SaaS Dashboard Wireframe Starter",
        "layoutDensity": "spacious",
        "tagline": "4 Verified Catalog Components"
      },
      "children": [
        "wf-blk-hero",
        "wf-blk-metrics",
        "wf-blk-features",
        "wf-aa-note",
        "wf-zz-note",
        "wf-blk-rogue"
      ]
    },
    "wf-blk-hero": {
      "type": "HeroSection",
      "props": {
        "eyebrow": "B2B SaaS · @genui-studio/core",
        "headline": "Zero-trust edge firewall",
        "primaryCta": "Deploy saas-dashboard-starter",
        "secondaryCta": "Catalog SHA: sha256-saas-da",
        "summary": {
          "$state": "/wireframeBindings/selectedRegion"
        }
      },
      "children": []
    },
    "wf-blk-metrics": {
      "type": "MetricStrip",
      "props": {
        "heading": "kpi telemetry",
        "primaryLabel": "Live p95 latency per region",
        "primaryValue": "$48.2K",
        "secondaryLabel": "Median API Latency",
        "secondaryValue": "18.4ms",
        "uptimePercent": 99.98
      },
      "children": []
    },
    "wf-blk-features": {
      "type": "FeatureGrid",
      "props": {
        "columns": 3,
        "items": [
          {
            "title": "SiteShell",
            "detail": "Top-level dashboard container organizing navigation badge, density, and sections."
          },
          {
            "title": "HeroSection",
            "detail": "Primary workspace banner with headline, bound summary state, and calls-to-action."
          },
          {
            "title": "MetricStrip",
            "detail": "Horizontal KPI highlight grid displaying bounded numeric telemetry and SLO percentage."
          },
          {
            "title": "FeatureGrid",
            "detail": "Multi-column capability or pricing tier grid with bounded column counts."
          }
        ],
        "sectionTitle": "Capabilities"
      },
      "children": []
    },
    "wf-aa-note": {
      "type": "MetricStrip",
      "props": {
        "heading": "Stacked note A (same x/y as Z)",
        "primaryLabel": "Monthly Recurring Revenue",
        "primaryValue": "$48.2K",
        "secondaryLabel": "Median API Latency",
        "secondaryValue": "18.4ms",
        "uptimePercent": 99.98
      },
      "children": []
    },
    "wf-zz-note": {
      "type": "MetricStrip",
      "props": {
        "heading": "Stacked note Z (same x/y as A)",
        "primaryLabel": "Monthly Recurring Revenue",
        "primaryValue": "$48.2K",
        "secondaryLabel": "Median API Latency",
        "secondaryValue": "18.4ms",
        "uptimePercent": 99.98
      },
      "children": []
    },
    "wf-blk-rogue": {
      "type": "HeroSection",
      "props": {
        "eyebrow": "B2B SaaS · @genui-studio/core",
        "headline": "hero banner",
        "primaryCta": "Deploy saas-dashboard-starter",
        "secondaryCta": "Catalog SHA: sha256-saas-da",
        "summary": "<script>alert(1)</script>"
      },
      "children": []
    }
  },
  "state": {
    "wireframeBindings": {
      "selectedRegion": "selectedRegion"
    }
  }
}
