{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/cmos/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/cmos/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/cmos",
      "destination": "/index.html"
    },
    {
      "source": "/((?!assets/|images/|.*\\.(?:js|css|svg|png|jpg|jpeg|webp|woff2|ico|json|map)$).*)",
      "destination": "/index.html"
    }
  ]
}
