{
  "name": "genui-studio",
  "version": "1.0.0",
  "description": "WizFrame CLI (genui-studio): validate UI specs, fuzz-test interaction rules, and export runnable Next.js starters or Agent Skill Packs.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "genui-studio": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/__tests__",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@genui-studio/core": "workspace:*",
    "@genui-studio/templates": "workspace:*",
    "jszip": "^3.10.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
