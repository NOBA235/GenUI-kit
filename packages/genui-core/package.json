{
  "name": "@genui-studio/core",
  "version": "1.0.0",
  "description": "Reusable Generative UI Skeleton Engine: Guardrailed Catalog Synchronizer, RFC 6902 Stream Sanitizer, DAG Cycle Detector, Bidirectional State Store, Telemetry Error Boundary, and fast-check Fuzzing Arbitraries for @json-render.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./registry": {
      "types": "./dist/registry/index.d.ts",
      "import": "./dist/registry/index.js",
      "default": "./dist/registry/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:fuzz": "vitest run src/__tests__/invariants.fuzz.test.ts"
  },
  "dependencies": {
    "@json-render/core": "^0.22.0",
    "@json-render/react": "^0.22.0",
    "jszip": "^3.10.2",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/jszip": "^3.4.1",
    "fast-check": "^4.10.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vitest": "^3.0.0"
  }
}
