{
  "name": "@genui-studio/mcp",
  "version": "1.0.0",
  "description": "GenUI Studio Model Context Protocol (MCP) Server: Exposes Catalog Inspection, Zod Prop Schema Extraction, RFC 6902 UI Spec Validation, DAG Cycle Remediation, and Property-Based Testing (PBT) Fuzzing to Kiro IDE, CLI, and AI Agents.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "genui-mcp": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@genui-studio/core": "workspace:*",
    "@json-render/core": "^0.22.0",
    "@json-render/react": "^0.22.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fast-check": "^4.10.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
