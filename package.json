{
  "name": "genui-studio-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "WizFrame (GenUI-kit): Interactive UI Workbench with declarative interaction rules, playtest fuzzing, and Next.js / Agent Skill exports, powered by @genui-studio/core and @json-render.",
  "license": "MIT",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:all": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:hub": "pnpm --filter @genui-studio/studio-hub dev",
    "dev:ninety9": "pnpm --filter @genui-studio/app-ninety9-archive dev",
    "dev:cmos": "pnpm --filter @genui-studio/app-cmos-cloud-bios dev",
    "new:template": "node scripts/new-template.ts",
    "ingest:standalone": "node scripts/ingest-standalone.ts",
    "sync:templates": "node scripts/sync-templates.ts",
    "generate:ninety9-assets": "node scripts/generate-ninety9-assets.ts",
    "genui-studio": "node packages/genui-cli/dist/cli.js",
    "build": "pnpm -r --filter ./packages/* build && pnpm -r --filter ./apps/* build",
    "test": "pnpm -r test",
    "test:fuzz": "pnpm --filter @genui-studio/core test:fuzz",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/parser": "^8.73.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0",
    "zod": "^4.3.6"
  },
  "dependencies": {
    "@types/jszip": "^3.4.1",
    "jszip": "^3.10.2"
  }
}
